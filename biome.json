{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "assist": {
    "actions": {
      "recommended": true,
      "source": {
        "recommended": true
      }
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "*.json",
      "!package-lock.json",
      "webpack.config.js"
    ]
  },
  "formatter": {
    "attributePosition": "multiline",
    "enabled": true,
    "expand": "always",
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "operatorLinebreak": "before",
      "quoteProperties": "preserve",
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": "error",
      "correctness": "error",
      "nursery": {
        "useExplicitReturnType": "error",
        "useExplicitType": "error"
      },
      "performance": "error",
      "recommended": true,
      "security": "error",
      "style": "error",
      "suspicious": "error"
    }
  },
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
